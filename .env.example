# ── BACKEND (.env in /backend) ───────────────────────────────────────────────

# Supabase — get from: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Keep secret! Never commit.

# Google OAuth — create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Gmail SMTP — use an App Password, NOT your real Gmail password
# Enable 2FA then: https://myaccount.google.com/apppasswords
GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Flask
FLASK_SECRET_KEY=change-this-to-a-long-random-string
FRONTEND_URL=http://localhost:3000   # In prod: https://your-app.vercel.app


# ── FRONTEND (.env.local in /frontend) ───────────────────────────────────────

# Supabase public keys (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Flask backend URL
NEXT_PUBLIC_API_URL=http://localhost:5000   # In prod: https://your-app.onrender.com
